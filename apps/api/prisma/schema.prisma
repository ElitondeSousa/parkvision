// ParkVision — modelo de dados do MVP (Etapa 1)
// Substitui, para o MVP, o esquema de planejamento em backend/prisma/schema.prisma.
// Regras: ocupação muda só na confirmação de estacionamento e na saída (sem reserva).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Categoria {
  CARRO_PEQUENO
  CARRO_GRANDE
  MOTO
}

/// Tipo de vaga declarado na entrada (orientação; o sistema não verifica credencial).
enum TipoVaga {
  COMUM
  PCD
  IDOSO
}

enum StatusTicket {
  AGUARDANDO
  ESTACIONADO
  SAIU
  CANCELADO
}

enum TipoEvento {
  ENTRADA_VAGA
  SAIDA_VAGA
  AJUSTE
}

model Regiao {
  id              String            @id // N1, N2, ..., SS2L (ids do mapa digital)
  nome            String
  nivel           String // terreo | ss1 | ss2
  capacidade      Int
  ocupadas        Int               @default(0)
  operacional     Boolean           @default(true)
  fonteCapacidade String // planta | desenho | simulada
  // Vagas reservadas (PcD e pessoa idosa) dentro da capacidade total; as comuns são o restante.
  // Invariantes (garantidas pelos UPDATEs condicionados): 0 <= ocupadasX <= capacidadeX; capacidadePcd + capacidadeIdoso <= capacidade;
  // ocupadas - ocupadasPcd - ocupadasIdoso <= capacidade - capacidadePcd - capacidadeIdoso.
  capacidadePcd        Int     @default(0)
  capacidadeIdoso      Int     @default(0)
  ocupadasPcd          Int     @default(0)
  ocupadasIdoso        Int     @default(0)
  fonteVagasReservadas String  @default("sem-reserva") // planta | proposta | operador | sem-reserva
  // Estado vindo dos sensores (reais ou simulados). A marca *Simulado diz o que o reinício da simulação pode desfazer.
  bloqueioSimulado       Boolean   @default(false) // indisponibilidade temporária gerada pela simulação
  statusSensores         String    @default("ok") // ok | sem-comunicacao | inconsistente
  statusSensoresSimulado Boolean   @default(false)
  fluxoSensor            Int       @default(0) // veículos em circulação medidos pelos sensores de fluxo
  fluxoSensorAte         DateTime?
  fluxoSimulado          Boolean   @default(false)
  versao                 Int       @default(0) // sobe a cada mudança da linha (ordem dos eventos em tempo real)
  atualizadoEm    DateTime          @default(now()) @updatedAt
  categorias      RegiaoCategoria[]
  eventos         EventoOcupacao[]
  recomendadas    Ticket[]          @relation("recomendada")
  estacionadas    Ticket[]          @relation("estacionada")
  recomendacoes   Recomendacao[]

  @@map("regiao")
}

model RegiaoCategoria {
  regiaoId  String
  categoria Categoria
  regiao    Regiao    @relation(fields: [regiaoId], references: [id], onDelete: Cascade)

  @@id([regiaoId, categoria])
  @@map("regiao_categoria")
}

model Acesso {
  id      String   @id // A_NE, A_ROT, A_S1, A_S2, ...
  nome    String
  nivel   String
  noMapa  String
  tickets Ticket[]

  @@map("acesso")
}

model Ticket {
  numero              Int           @id @default(autoincrement())
  codigo              String        @unique // PV-0001 (impresso)
  tokenHash           String        @unique // SHA-256 do token do QR Code (o token em claro não é guardado)
  categoria           Categoria
  tipoVaga            TipoVaga      @default(COMUM)
  acessoId            String
  acesso              Acesso        @relation(fields: [acessoId], references: [id])
  placa               String?
  entradaEm           DateTime      @default(now())
  regiaoRecomendadaId String
  regiaoRecomendada   Regiao        @relation("recomendada", fields: [regiaoRecomendadaId], references: [id])
  regiaoEstacionadaId String?
  regiaoEstacionada   Regiao?       @relation("estacionada", fields: [regiaoEstacionadaId], references: [id])
  estacionadoEm       DateTime?
  saidaEm             DateTime?
  status              StatusTicket  @default(AGUARDANDO)
  simulado            Boolean       @default(false) // gerado pelo simulador (pode ser apagado no reinício)
  recomendacoes       Recomendacao[]
  eventos             EventoOcupacao[]

  @@index([status, entradaEm])
  @@index([simulado])
  @@map("ticket")
}

model Recomendacao {
  id            String   @id @default(uuid())
  ticketNumero  Int
  ticket        Ticket   @relation(fields: [ticketNumero], references: [numero], onDelete: Cascade)
  regiaoId      String
  regiao        Regiao   @relation(fields: [regiaoId], references: [id])
  score         Float
  pesos         Json
  avaliacoes    Json // avaliação de todas as regiões (transparência)
  justificativa String
  rota          Json
  criadaEm      DateTime @default(now())

  @@index([ticketNumero])
  @@index([regiaoId, criadaEm])
  @@map("recomendacao")
}

model EventoOcupacao {
  id           BigInt     @id @default(autoincrement())
  regiaoId     String
  regiao       Regiao     @relation(fields: [regiaoId], references: [id])
  tipo         TipoEvento
  origem       String // totem | simulador | operador | sistema
  ticketNumero Int?
  ticket       Ticket?    @relation(fields: [ticketNumero], references: [numero], onDelete: Cascade)
  simulado     Boolean    @default(false)
  ocorridoEm   DateTime   @default(now())

  @@index([regiaoId, ocorridoEm])
  @@map("evento_ocupacao")
}

/// Eventos de sensor recebidos (reais ou simulados). O id externo garante idempotência:
/// o mesmo evento processado duas vezes não altera a ocupação de novo.
model EventoSensor {
  eventoId     String   @id
  sensorId     String
  regiaoId     String
  tipo         String // VAGA_OCUPADA | VAGA_LIBERADA | SEM_COMUNICACAO | LEITURA_INCONSISTENTE | SENSOR_NORMALIZADO | FLUXO | DISPONIBILIDADE
  ticketCodigo String?
  payload      Json
  resultado    String // APLICADO | IGNORADO_SEM_TICKET | REJEITADO_* ...
  simulado     Boolean  @default(false)
  recebidoEm   DateTime @default(now())

  @@index([regiaoId, recebidoEm])
  @@index([simulado])
  @@map("evento_sensor")
}
