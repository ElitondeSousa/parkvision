# Copie para apps/api/.env e ajuste se necessário. Não versionar o .env.
DATABASE_URL="postgresql://parkvision:parkvision@localhost:5433/parkvision"
DATABASE_URL_TESTE="postgresql://parkvision:parkvision@localhost:5433/parkvision_teste"
PORTA=3333
WEB_URL="http://localhost:5173"
SIMULADOR_TOKEN="troque-este-token"
# Token do operador (confirmar estacionamento, saída, ajustes e controle do simulador). Sem ele, vale o SIMULADOR_TOKEN.
# OPERADOR_TOKEN="troque-este-token-do-operador"
# Modo demonstração: tudo o que o totem e o painel criarem é marcado como simulado (o reinício da demo limpa tudo).
# Use "false" num ambiente com dados reais.
MODO_DEMONSTRACAO="true"
